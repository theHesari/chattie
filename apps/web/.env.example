# Base URL of the FastAPI service (services/llm).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Auth (Better Auth). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical URL of this app; also the JWT issuer/audience the API checks (AUTH_ISSUER in the root .env).
BETTER_AUTH_URL=http://localhost:3001
# Other origins the app may be opened from (comma-separated).
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001
# Better Auth's tables live in their own schema ("auth"); create it first: CREATE SCHEMA auth;
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chattie?options=-c%20search_path%3Dauth
